{
  "title": "Scientist4J PetClinic",
  "uid": "petclinic-overview",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP Requests",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ],
      "gridPos": {"x":0, "y":0, "w":24, "h":9}
    },
    {
      "type": "stat",
      "title": "Uptime",
      "targets": [
        {
          "expr": "time() - process_start_time_seconds"
        }
      ],
      "gridPos": {"x":0, "y":9, "w":12, "h":6}
    },
    {
      "type": "timeseries",
      "title": "JVM Memory Used",
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"}"
        }
      ],
      "gridPos": {"x":12, "y":9, "w":12, "h":6}
    }
  ]
}
